{
  "name": "peel-and-stick",
  "version": "0.1.0",
  "description": "Realistic peel-and-stick stickers for React. Peel them off a glossy backing, stick them anywhere on the page, and peel them again.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./maker": {
      "types": "./dist/maker.d.ts",
      "import": "./dist/maker.js",
      "require": "./dist/maker.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "sticker",
    "stickers",
    "peel",
    "drag",
    "animation",
    "ui",
    "fun"
  ],
  "scripts": {
    "art": "node scripts/build-art.mjs",
    "figma:sync": "node scripts/figma-sync.mjs",
    "build": "npm run art && tsup",
    "dev": "next dev site",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "site:build": "next build site",
    "wordmark": "node scripts/build-wordmark.mjs",
    "dev:package": "tsup --watch",
    "site:start": "next start site"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.3.1",
    "next": "^16.4.3",
    "opentype.js": "^1.3.4",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "typesVersions": {
    "*": {
      "maker": [
        "./dist/maker.d.ts"
      ]
    }
  }
}
